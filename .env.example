# Voceive Production Environment Variables
# Copy to .env and fill in values before running docker compose -f docker-compose.prod.yml up

# Required — Rails master key (from apps/api/config/master.key)
RAILS_MASTER_KEY=

# Required — PostgreSQL password
POSTGRES_PASSWORD=

# Required — OpenAI API key for AI features
OPENAI_API_KEY=

# Optional — OpenAI model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional — CORS allowed origins (default: http://localhost)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Optional — Web port (default: 80)
WEB_PORT=80
