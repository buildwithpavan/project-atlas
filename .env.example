# Voceive Staging / Production Environment Variables
# Copy to .env and fill in values before running:
#   docker compose -f docker-compose.prod.yml up

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Rails master key (from apps/api/config/master.key)
RAILS_MASTER_KEY=

# PostgreSQL credentials
POSTGRES_USER=atlas
POSTGRES_PASSWORD=

# OpenAI API key for AI features
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# Shared secret between API and AI service (service-to-service auth)
AI_INTERNAL_TOKEN=

# CORS allowed origins (comma-separated; default: http://localhost)
CORS_ALLOWED_ORIGINS=http://localhost

# ---------------------------------------------------------------------------
# Optional (sensible defaults provided)
# ---------------------------------------------------------------------------

# OpenAI model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# AI service request timeout in seconds (default: 30)
# AI_SERVICE_TIMEOUT=30

# Web frontend host port (default: 80)
# WEB_PORT=80
